<Window x:Class="PageCompose.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PageCompose.App"
        xmlns:vm="clr-namespace:PageCompose.App.ViewModels"
        Title="{local:Tr AppTitle}" Icon="Assets/PageCompose.ico"
        Width="1360" Height="900" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ApplicationBackgroundBrush}"
        AllowDrop="True" DragEnter="Window_DragOver" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- Rounded thumbnail -->
        <DataTemplate x:Key="Thumbnail" DataType="{x:Type vm:VisualItem}">
            <Grid Width="48" Height="48">
                <Border CornerRadius="4" Background="{DynamicResource ControlAltFillColorTertiaryBrush}" />
                <Border CornerRadius="4">
                    <Border.Background>
                        <!-- The thumbnail is read upright (EXIF); the user's turn is applied here -->
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill">
                            <ImageBrush.RelativeTransform>
                                <RotateTransform CenterX="0.5" CenterY="0.5" Angle="{Binding Rotation}" />
                            </ImageBrush.RelativeTransform>
                        </ImageBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Right click on a file line: turn the visual (a photo imported sideways) -->
        <ContextMenu x:Key="VisualMenu" x:Shared="False">
            <!-- Lines of a list only: the same photo in another size, typically (Mixed sizes) -->
            <MenuItem Header="{local:Tr DuplicateLine}" Command="{Binding DuplicateCommand}"
                      Visibility="{Binding DuplicateCommand, Converter={StaticResource NullToCollapsed}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Visibility="{Binding DuplicateCommand, Converter={StaticResource NullToCollapsed}}" />
            <MenuItem Header="{local:Tr RotateRight}" Command="{Binding RotateRightCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{local:Tr RotateLeft}" Command="{Binding RotateLeftCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource IconFont}" FontSize="16" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{local:Tr RotateHalf}" Command="{Binding RotateHalfCommand}" />
            <!-- How it lies in its cell: the general setting, or its own (asked by the author) -->
            <Separator />
            <MenuItem Header="{local:Tr LineFitDefault}" Command="{Binding FitDefaultCommand}" IsCheckable="True" IsChecked="{Binding IsFitDefault, Mode=OneWay}" />
            <MenuItem Header="{local:Tr LineFitFill}" Command="{Binding OwnFillCommand}" IsCheckable="True" IsChecked="{Binding IsOwnFill, Mode=OneWay}" />
            <MenuItem Header="{local:Tr LineFitFit}" Command="{Binding OwnFitCommand}" IsCheckable="True" IsChecked="{Binding IsOwnFit, Mode=OneWay}" />
            <!-- Back to the automatic turn alone (it is kept through every change of the settings until then) -->
            <Separator />
            <MenuItem Header="{local:Tr RotateAuto}" Command="{Binding RotateAutoCommand}" IsEnabled="{Binding IsTurnedByHand}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <!-- Back to the middle of the photo, once it was dragged on the preview -->
            <MenuItem Header="{local:Tr RecenterPhoto}" Command="{Binding RecenterCommand}" IsEnabled="{Binding IsCropMoved}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7AC;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Page of a PDF of several pages: "Page 2 / 3" -->
        <DataTemplate x:Key="PagePicker" DataType="{x:Type vm:VisualItem}">
            <ComboBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" DisplayMemberPath="Name"
                      HorizontalAlignment="Left" MinWidth="130" Margin="0,6,0,0" AutomationProperties.Name="{local:Tr PagePicker}"
                      Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}" />
        </DataTemplate>

        <Style x:Key="QualityText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowQuality}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Single visual (Repeat mode, back) -->
        <DataTemplate x:Key="SingleRow" DataType="{x:Type vm:VisualItem}">
            <Border Style="{StaticResource FileRow}" Margin="0" ContextMenu="{StaticResource VisualMenu}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Thumbnail}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding RemoveCommand}"
                            ToolTip="{local:Tr RemoveVisualTooltip}" AutomationProperties.Name="{local:Tr RemoveVisualTooltip}" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Info.OriginalPath}" />
                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Quality}" Style="{StaticResource QualityText}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PagePicker}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Mixed mode: the size of the print, on its line (preset sizes only) -->
        <DataTemplate x:Key="SizePicker" DataType="{x:Type vm:VisualItem}">
            <DockPanel>
                <!-- "Custom": its width and height, typed on the line -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                            Visibility="{Binding IsCustomFormat, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Width="64" MinWidth="0" AutomationProperties.Name="{local:Tr WidthMm}"
                             Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0" />
                    <TextBox Width="64" MinWidth="0" AutomationProperties.Name="{local:Tr HeightMm}"
                             Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    <TextBlock Text="{local:Tr Millimetres}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding DataContext.MixedFormats, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Format}" DisplayMemberPath="Name" AutomationProperties.Name="{local:Tr ItemSize}"
                          HorizontalAlignment="Stretch" />
            </DockPanel>
        </DataTemplate>

        <!-- Double-sided: the back of a line of the list. Its own (dropped, chosen, or found by the app: "auto"), else a
             slot to drop one; meanwhile the shared back of the "Double-sided" card is printed behind it. -->
        <DataTemplate x:Key="LineBack" DataType="{x:Type vm:VisualItem}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Width="48" Text="{local:Tr BackLabel}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- A file dropped on the line's back replaces it -->
                <Grid AllowDrop="True" DragOver="VersoZone_DragOver" Drop="LineBack_Drop" Background="Transparent">
                    <DockPanel Visibility="{Binding HasBack, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding Back.RemoveCommand}"
                                ToolTip="{local:Tr RemoveBackTooltip}" AutomationProperties.Name="{local:Tr RemoveBackTooltip}" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,1,9,2" Margin="6,0,6,0" VerticalAlignment="Center"
                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" ToolTip="{local:Tr LineBackAutoTooltip}"
                                Visibility="{Binding IsBackAuto, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{local:Tr LineBackAuto}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <!-- Right click: turn it, centre it, as a front -->
                        <DockPanel DataContext="{Binding Back}" ContextMenu="{StaticResource VisualMenu}" Background="Transparent">
                            <Viewbox DockPanel.Dock="Left" Width="34" Height="34">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Thumbnail}" />
                            </Viewbox>
                            <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NameWithPage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Info.OriginalPath}" />
                                <TextBlock Text="{Binding Quality}" Style="{StaticResource QualityText}"
                                           Visibility="{Binding IsLowQuality, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>
                    <Button Style="{StaticResource DropZoneButton}" Padding="10,7" HorizontalContentAlignment="Left" Click="LineBack_Click"
                            AutomationProperties.Name="{local:Tr DropLineBack}"
                            Visibility="{Binding HasBack, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{local:Tr DropLineBack}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- Visual of a composition, with its number of copies. In the Mixed mode, its size on a row of its own, across
             the whole line, so that long size names show in full (chosen by the author among three places). -->
        <DataTemplate x:Key="ComposeRow" DataType="{x:Type vm:VisualItem}">
            <Border Style="{StaticResource FileRow}" ContextMenu="{StaticResource VisualMenu}">
                <StackPanel>
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Thumbnail}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding RemoveCommand}"
                                ToolTip="{local:Tr RemoveVisualTooltip}" AutomationProperties.Name="{local:Tr RemoveVisualTooltip}" VerticalAlignment="Center" />
                        <!-- A little room between the buttons: their hover backgrounds would touch -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE738;" Command="{Binding DecrementCommand}" Margin="0,0,4,0"
                                    ToolTip="{local:Tr LessCopyTooltip}" AutomationProperties.Name="{local:Tr LessCopyTooltip}" />
                            <TextBox Width="54" MinWidth="54" TextAlignment="Center" AutomationProperties.Name="{local:Tr CopiesLabel}"
                                     Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged, Delay=400}" ToolTip="{local:Tr CopiesTooltip}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding IncrementCommand}" Margin="4,0,0,0"
                                    ToolTip="{local:Tr MoreCopyTooltip}" AutomationProperties.Name="{local:Tr MoreCopyTooltip}" />
                        </StackPanel>
                        <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Info.OriginalPath}" />
                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Quality}" Style="{StaticResource QualityText}" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PagePicker}" />
                        </StackPanel>
                    </DockPanel>
                    <ContentControl Margin="0,6,0,0" Content="{Binding}" ContentTemplate="{StaticResource SizePicker}"
                                    Visibility="{Binding DataContext.IsMixedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                    <ContentControl Margin="0,8,0,0" Content="{Binding}" ContentTemplate="{StaticResource LineBack}"
                                    Visibility="{Binding DataContext.VersoEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A notice in full (the details of the line under the preview): Windows 11 InfoBar colours -->
        <DataTemplate x:Key="NoticeItem" DataType="{x:Type vm:Notice}">
            <!-- Windows 11 InfoBar colours -->
            <Border x:Name="Box" CornerRadius="6" Padding="12,7" Margin="0,3,0,0" BorderThickness="1"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <TextBlock x:Name="Glyph" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,10,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:NoticeLevel.Warning}">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:NoticeLevel.Error}">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Settings panel ==================== -->
        <!-- On the window background (Mica on Windows 11, as the title bar): only the cards stand out. -->
        <DockPanel Grid.Column="0">
            <!-- Only the export buttons stay fixed at the bottom: their options are in the last section (asked by the author) -->
            <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PrimaryButton}" Content="{local:Tr ExportButton}" IsEnabled="{Binding CanExport}" Click="Export_Click" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{local:Tr ExportJpegButton}"
                            IsEnabled="{Binding CanExport}" Click="ExportJpeg_Click" ToolTip="{local:Tr ExportJpegTooltip}" />
                </Grid>
            </Border>

            <!-- Fixed above the settings that scroll: the title, the Settings button and the presets. -->
            <Border DockPanel.Dock="Top" Padding="18,18,18,14" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="16" Width="36" Height="36"
                                VerticalAlignment="Top" Click="Settings_Click"
                                ToolTip="{local:Tr SettingsTooltip}" AutomationProperties.Name="{local:Tr SettingsTooltip}" />
                        <StackPanel>
                            <TextBlock Text="{local:Tr AppTitle}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{local:Tr AppSubtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Presets: the settings of a usual job (no files, no number of copies) -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="16" Width="34" Height="34"
                                Click="DeletePreset_Click" IsEnabled="{Binding HasPreset}"
                                ToolTip="{local:Tr PresetDelete}" AutomationProperties.Name="{local:Tr PresetDelete}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74E;" FontSize="16" Width="34" Height="34"
                                Margin="6,0,2,0" Click="SavePreset_Click"
                                ToolTip="{local:Tr PresetSave}" AutomationProperties.Name="{local:Tr PresetSave}" />
                        <Grid>
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" DropDownOpened="Presets_DropDownOpened"
                                      AutomationProperties.Name="{local:Tr Presets}" />
                            <TextBlock Text="{local:Tr PresetNone}" IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasPreset, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Not focusable: clicked after typing, it would show a keyboard focus frame around the whole column. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" FocusVisualStyle="{x:Null}">
                <StackPanel Margin="18,14,18,6">
                    <!-- Mode -->
                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}" CornerRadius="6" Padding="3">
                        <UniformGrid Columns="3">
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="mode" Content="{local:Tr ModeRepeat}" IsChecked="{Binding IsRepeatMode}" />
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="mode" Content="{local:Tr ModeCompose}" IsChecked="{Binding IsComposeMode}" />
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="mode" Content="{local:Tr ModeMixed}" IsChecked="{Binding IsMixedMode}" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,14" Text="{local:Tr ModeRepeatHint}"
                               Visibility="{Binding IsRepeatMode, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,14" Text="{local:Tr ModeComposeHint}"
                               Visibility="{Binding IsComposeMode, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,14" Text="{local:Tr ModeMixedHint}"
                               Visibility="{Binding IsMixedMode, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Visual (Repeat) -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsRepeatMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{local:Tr SectionVisual}" />
                            <Button Style="{StaticResource DropZoneButton}" Click="BrowseVisuals_Click" AutomationProperties.Name="{local:Tr DropVisual}"
                                    Visibility="{Binding HasRepeatVisual, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{local:Tr DropVisual}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{local:Tr FileTypes}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ContentControl Content="{Binding RepeatVisual}" ContentTemplate="{StaticResource SingleRow}"
                                            Visibility="{Binding HasRepeatVisual, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Visuals (Compose and Mixed) -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasVisualList, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{local:Tr ClearAll}" Command="{Binding ClearVisualsCommand}" Padding="10,3" Margin="0,-4,0,6"
                                        Visibility="{Binding HasVisuals, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="{local:Tr SectionVisuals}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Visuals}" ItemTemplate="{StaticResource ComposeRow}" />
                            <Button Style="{StaticResource DropZoneButton}" Click="BrowseVisuals_Click" AutomationProperties.Name="{local:Tr DropVisualsAdd}">
                                <StackPanel>
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{Binding VisualsDropHint}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{local:Tr DropVisualsHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="{local:Tr FileTypes}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding FilesMessage}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="2,-6,0,12"
                               Visibility="{Binding FilesMessage, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Back -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding VersoEnabled}" AutomationProperties.Name="{local:Tr DuplexTitle}">
                                <TextBlock Text="{local:Tr DuplexTitle}" FontWeight="SemiBold" />
                            </CheckBox>
                            <StackPanel Visibility="{Binding VersoEnabled, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                <!-- In the lists, each line may have its own back: this one is for the others -->
                                <TextBlock Text="{local:Tr SharedBackCaption}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"
                                           Visibility="{Binding HasVisualList, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource DropZoneButton}" Click="BrowseVerso_Click" AutomationProperties.Name="{local:Tr DropVerso}"
                                        DragOver="VersoZone_DragOver" Drop="VersoZone_Drop"
                                        Visibility="{Binding HasVerso, Converter={StaticResource InverseBoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{local:Tr DropVerso}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="{local:Tr DropVersoHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"
                                                   Visibility="{Binding IsRepeatMode, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Button>
                                <ContentControl Content="{Binding Verso}" ContentTemplate="{StaticResource SingleRow}"
                                                Visibility="{Binding HasVerso, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource Error}" Text="{Binding VersoError}"
                                           Visibility="{Binding VersoError, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Text="{local:Tr FlipTitle}" Margin="0,10,0,2" />
                                <WrapPanel>
                                    <RadioButton GroupName="flip" Content="{local:Tr FlipLongEdge}" IsChecked="{Binding FlipLongEdge}" />
                                    <RadioButton GroupName="flip" Content="{local:Tr FlipShortEdge}" IsChecked="{Binding FlipShortEdge}" />
                                </WrapPanel>
                                <CheckBox Content="{local:Tr RotateVerso}" IsChecked="{Binding RotateVerso180}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{local:Tr DuplexHint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Size (in the Mixed mode, each line has its own) -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsMixedMode, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{local:Tr SectionFormat}" />
                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Tr SectionFormat}" />
                            <Grid Margin="0,10,0,0" Visibility="{Binding IsCustomFormat, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr WidthMm}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                    <TextBox AutomationProperties.Name="{local:Tr WidthMm}" Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{local:Tr HeightMm}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                    <TextBox AutomationProperties.Name="{local:Tr HeightMm}" Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                </StackPanel>
                            </Grid>

                            <!-- White margins inside each visual, side by side -->
                            <CheckBox Content="{local:Tr WhiteMargins}" IsChecked="{Binding MarginsEnabled}" Margin="0,10,0,0" />
                            <StackPanel Visibility="{Binding MarginsEnabled, Converter={StaticResource BoolToVisibility}}">
                                <UniformGrid Columns="4" Margin="0,4,-8,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{local:Tr MarginTop}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox AutomationProperties.Name="{local:Tr MarginTop}" MinWidth="0" Text="{Binding MarginTop, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{local:Tr MarginBottom}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox AutomationProperties.Name="{local:Tr MarginBottom}" MinWidth="0" Text="{Binding MarginBottom, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{local:Tr MarginLeft}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox AutomationProperties.Name="{local:Tr MarginLeft}" MinWidth="0" Text="{Binding MarginLeft, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{local:Tr MarginRight}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox AutomationProperties.Name="{local:Tr MarginRight}" MinWidth="0" Text="{Binding MarginRight, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Hint}" Text="{local:Tr MarginsHint}" />
                                <!-- Off: the back covers the whole cell, which hides the small front/back offset of duplex printing -->
                                <CheckBox Content="{local:Tr VersoMargins}" IsChecked="{Binding VersoMargins}" Margin="0,6,0,0"
                                          Visibility="{Binding VersoEnabled, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sheet -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{local:Tr SectionSheet}" />
                            <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Tr SectionSheet}" />
                            <!-- Custom sheet: size and unprintable margin -->
                            <Grid Margin="0,10,0,0" Visibility="{Binding IsCustomSheet, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Tr WidthMm}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                    <TextBox AutomationProperties.Name="{local:Tr WidthMm}" Text="{Binding CustomSheetWidth, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{local:Tr HeightMm}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                    <TextBox AutomationProperties.Name="{local:Tr HeightMm}" Text="{Binding CustomSheetHeight, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{local:Tr SheetMargin}" VerticalAlignment="Center" />
                                    <TextBox AutomationProperties.Name="{local:Tr SheetMargin}" Width="64" Margin="12,0,6,0"
                                             Text="{Binding CustomSheetMargin, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                    <TextBlock Text="{local:Tr Millimetres}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cutting -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{local:Tr SectionCutting}" />
                            <!-- Mixed mode: crop marks for the cuts that reach the edge of the block only, and cut lines
                                 of its own (along each cut, on by default) -->
                            <CheckBox Content="{local:Tr CropMarks}" IsChecked="{Binding CropMarks}" />
                            <CheckBox Content="{local:Tr CutLines}" IsChecked="{Binding CutLines}"
                                      Visibility="{Binding IsMixedMode, Converter={StaticResource InverseBoolToVisibility}}" />
                            <CheckBox Content="{local:Tr MixedCutLines}" IsChecked="{Binding MixedCutLines}"
                                      Visibility="{Binding IsMixedMode, Converter={StaticResource BoolToVisibility}}" />
                            <!-- The colour of the cut lines, over the visuals (asked by the author): white shows on dark photos -->
                            <DockPanel Margin="28,2,0,6" Visibility="{Binding ShowCutLineColor, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{local:Tr CutLineColor}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding CutLineColors}" SelectedItem="{Binding SelectedCutLineColor}" MinWidth="150"
                                          HorizontalAlignment="Left" AutomationProperties.Name="{local:Tr CutLineColor}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CutLineColorOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Background="{Binding Swatch}" BorderThickness="1"
                                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <!-- Bleed and spacing: values aligned in one column -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Content="{local:Tr Bleed}" IsChecked="{Binding BleedEnabled}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" AutomationProperties.Name="{local:Tr BleedMm}" Width="64" Margin="12,2,6,2" VerticalAlignment="Center"
                                         Text="{Binding BleedMm, UpdateSourceTrigger=PropertyChanged, Delay=400}" IsEnabled="{Binding BleedEnabled}" />
                                <TextBlock Grid.Column="2" Text="{local:Tr Millimetres}" VerticalAlignment="Center" />
                                <CheckBox Grid.Row="1" Content="{local:Tr Spacing}" IsChecked="{Binding SpacingEnabled}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{local:Tr SpacingMm}" Width="64" Margin="12,2,6,2" VerticalAlignment="Center"
                                         Text="{Binding SpacingMm, UpdateSourceTrigger=PropertyChanged, Delay=400}" IsEnabled="{Binding SpacingEnabled}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{local:Tr Millimetres}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="{local:Tr BleedHint}" />
                            <TextBlock Text="{local:Tr FitTitle}" Margin="0,12,0,2" />
                            <RadioButton GroupName="fit" Content="{local:Tr FitFill}" IsChecked="{Binding IsFill}" />
                            <RadioButton GroupName="fit" Content="{local:Tr FitFit}" IsChecked="{Binding IsFit}" />
                        </StackPanel>
                    </Border>

                    <!-- Quantity -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{local:Tr SectionQuantity}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRepeatMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBox AutomationProperties.Name="{local:Tr Quantity}" Width="90" local:NumericInput.Minimum="1"
                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                <RadioButton GroupName="unit" Content="{local:Tr UnitItems}" IsChecked="{Binding UnitItems}" Margin="14,0,14,0" VerticalAlignment="Center" />
                                <RadioButton GroupName="unit" Content="{local:Tr UnitSheets}" IsChecked="{Binding UnitSheets}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="{local:Tr ComposeCopiesHint}"
                                       Visibility="{Binding HasVisualList, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox Content="{local:Tr CompleteLastSheet}" IsChecked="{Binding CompleteLastSheet}" Margin="0,6,0,2"
                                      Visibility="{Binding CanCompleteLastSheet, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding PlanText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Export: the options of the buttons fixed at the bottom -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{local:Tr SectionExport}" />
                            <CheckBox Content="{local:Tr FlattenPdf}" IsChecked="{Binding FlattenPdf}" ToolTip="{local:Tr FlattenPdfTooltip}" />
                            <!-- Mixed mode: a separate A4 PDF next to the export, to print on office paper (never on the sheets) -->
                            <CheckBox Content="{local:Tr CuttingPlan}" IsChecked="{Binding CuttingPlan}" ToolTip="{local:Tr CuttingPlanTooltip}"
                                      Visibility="{Binding IsMixedMode, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Name of the file, date and sheet number, small, in the waste outside the block -->
                            <CheckBox Content="{local:Tr SheetMark}" IsChecked="{Binding SheetMark}" ToolTip="{local:Tr SheetMarkTooltip}" />
                            <!-- A .PageComposeProject next to the export: its files and settings, opened again by a double click -->
                            <CheckBox Content="{local:Tr SaveProject}" IsChecked="{Binding SaveProject}" ToolTip="{local:Tr SaveProjectTooltip}" />
                            <!-- The project alone, without exporting the sheets (asked by the author) -->
                            <Button Content="{local:Tr ExportProject}" Click="ExportProject_Click" IsEnabled="{Binding HasAnyVisual}"
                                    HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" ToolTip="{local:Tr ExportProjectTooltip}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ==================== Preview ==================== -->
        <!-- The content layer of Windows 11 apps: a lighter surface with a rounded corner, beside the Mica column. -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" />
        <Grid Grid.Column="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- New version available (informational InfoBar), as in CropPdf -->
            <Border x:Name="UpdateBar" Margin="0,-8,0,14" Padding="14,6,6,6" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                    <!-- Hidden rather than disabled while installing -->
                    <Button x:Name="UpdateCloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                            Click="CloseUpdate_Click" ToolTip="{local:Tr Close}" AutomationProperties.Name="{local:Tr Close}" />
                    <StackPanel x:Name="UpdateActions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,4,0">
                        <Button Content="{local:Tr UpdateWhatsNew}" Margin="0,0,6,0" Click="UpdateNotes_Click" />
                        <Button Content="{local:Tr UpdateInstall}" Style="{DynamicResource AccentButtonStyle}" Click="UpdateInstall_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" DockPanel.Dock="Right" Width="180" Margin="12,0,10,0" Maximum="1"
                                 VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="1">
                <!-- Zoom: in % of the real size, as in PDF readers; "Fit" goes back to the whole sheet in view -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" FontSize="14" Content="&#xE71F;" Click="ZoomOut_Click"
                            ToolTip="{local:Tr ZoomOutTooltip}" AutomationProperties.Name="{local:Tr ZoomOutTooltip}" />
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{local:Tr ZoomTooltip}" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" FontSize="14" Content="&#xE8A3;" Click="ZoomIn_Click"
                            ToolTip="{local:Tr ZoomInTooltip}" AutomationProperties.Name="{local:Tr ZoomInTooltip}" />
                    <Button x:Name="ZoomFitButton" Style="{StaticResource IconButton}" FontSize="14" Content="&#xE9A6;" Margin="4,0,0,0"
                            Click="ZoomFit_Click" ToolTip="{local:Tr ZoomFitTooltip}" AutomationProperties.Name="{local:Tr ZoomFitTooltip}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasSeveralSheets, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousSheetCommand}"
                            ToolTip="{local:Tr PreviousSheetTooltip}" AutomationProperties.Name="{local:Tr PreviousSheetTooltip}" />
                    <TextBlock Text="{Binding PreviewSheetLabel}" VerticalAlignment="Center" Margin="8,0" MinWidth="96" TextAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextSheetCommand}"
                            ToolTip="{local:Tr NextSheetTooltip}" AutomationProperties.Name="{local:Tr NextSheetTooltip}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2" Margin="0,14,0,10">
                <!-- Fitted: no scroll bars, the sheets fill the area (Viewbox). Zoomed: the sides are laid out larger
                     inside the scroll viewer (MainWindow.xaml.cs, "Preview zoom"). -->
                <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                              Focusable="False" PreviewMouseWheel="PreviewScroll_PreviewMouseWheel" SizeChanged="PreviewScroll_SizeChanged">
                    <ItemsControl x:Name="PreviewSidesView" ItemsSource="{Binding PreviewSides}" Background="Transparent"
                                  MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove"
                                  MouseLeftButtonUp="Preview_MouseLeftButtonUp" LostMouseCapture="Preview_LostMouseCapture"
                                  MouseDown="Preview_MouseDown" MouseUp="Preview_MouseUp"
                                  LayoutUpdated="PreviewSidesView_LayoutUpdated">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PreviewSide}">
                                <DockPanel Margin="10,0">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"
                                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
                                    <Viewbox Stretch="Uniform">
                                        <!-- The sheet, in millimetres. A photo dragged keeps another part of it; a right click
                                             on it opens the menu of its line. -->
                                        <Grid Width="{Binding DataContext.SheetWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Height="{Binding DataContext.SheetHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="4"
                                              MouseLeftButtonDown="Sheet_MouseLeftButtonDown" MouseMove="Sheet_MouseMove"
                                              MouseLeftButtonUp="Sheet_MouseLeftButtonUp" LostMouseCapture="Sheet_LostMouseCapture"
                                              MouseRightButtonUp="Sheet_MouseRightButtonUp" MouseLeave="Sheet_MouseLeave">
                                            <!-- The sheet is paper: white in both themes -->
                                            <Border Background="White">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.22" />
                                                </Border.Effect>
                                            </Border>
    
                                            <!-- Cell outlines until the real preview is ready -->
                                            <ItemsControl ItemsSource="{Binding DataContext.PlaceholderCells, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Visibility="{Binding Image, Converter={StaticResource NullToVisible}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#DCE8F5" Stroke="#7FA6CF" StrokeThickness="0.4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
    
                                            <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- A photo being dragged: each copy of its line, the rest of it faded around its cell
                                                 (all of them first), then the part kept in its cell, until the preview is
                                                 rendered again -->
                                            <ItemsControl ItemsSource="{Binding Overlays}" IsHitTestVisible="False" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CropOverlay}">
                                                        <Image Source="{Binding Image}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill"
                                                               Opacity="0.35" RenderTransform="{Binding Transform}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Overlays}" IsHitTestVisible="False" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CropOverlay}">
                                                        <Canvas>
                                                            <Canvas Clip="{Binding Clip}">
                                                                <Image Source="{Binding Image}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill"
                                                                       RenderTransform="{Binding Transform}" />
                                                            </Canvas>
                                                            <Rectangle Canvas.Left="{Binding Cell.X}" Canvas.Top="{Binding Cell.Y}"
                                                                       Width="{Binding Cell.Width}" Height="{Binding Cell.Height}"
                                                                       Stroke="#005FB8" StrokeThickness="0.8" />
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Path Data="{Binding DataContext.MarginGeometry, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Fill="#2EE63946" IsHitTestVisible="False" />

                                            <!-- Mixed mode: the cutting order, on the front (the side up on the guillotine). On screen
                                                 only, like the red band: printed, the numbers would land on the photos. -->
                                            <ItemsControl ItemsSource="{Binding DataContext.CutNumbers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          IsHitTestVisible="False" Focusable="False"
                                                          Visibility="{Binding IsFront, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CutNumber}">
                                                        <!-- On paper (white in both themes), red as the cut lines of the simulations -->
                                                        <Grid Width="{Binding Size}" Height="{Binding Size}">
                                                            <Ellipse Fill="White" Stroke="#C42B1C" StrokeThickness="0.45" />
                                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontWeight="SemiBold"
                                                                       Foreground="#C42B1C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Viewbox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- The notices in full, opened from their line below, over the bottom of the preview (which does not move) -->
                <Grid x:Name="NoticePanel" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                      Visibility="{Binding NoticesOpen, Converter={StaticResource BoolToVisibility}}">
                    <!-- The shadow on a separate layer: an effect on the card itself would blur its text -->
                    <Border CornerRadius="8" Background="{DynamicResource FlyoutBackground}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="8" BorderThickness="1" Padding="8,5,8,8"
                            Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Notices}" ItemTemplate="{StaticResource NoticeItem}" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                             Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolToVisibility}}" />

                <!-- Shown while files are dragged over the window -->
                <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle RadiusX="12" RadiusY="12" Fill="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.92" />
                    <Rectangle RadiusX="12" RadiusY="12" Fill="{DynamicResource SubtleFillColorSecondaryBrush}"
                               Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" StrokeDashArray="6 4" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{local:Tr DropOverlayTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="{local:Tr DropOverlayHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="3">
                <!-- The notices on one line of a fixed height (asked by the author: their list changed the height of the
                     preview with each change). Hidden, not collapsed, when there is none: the preview keeps its size. -->
                <Border x:Name="NoticeBar" CornerRadius="6" Padding="12,0,10,0" Height="36" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" MouseLeftButtonUp="NoticeBar_MouseLeftButtonUp"
                        ToolTip="{Binding NoticeBarTooltip}" AutomationProperties.Name="{Binding NoticeDetail}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WorstNoticeLevel}" Value="{x:Static vm:NoticeLevel.Warning}">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WorstNoticeLevel}" Value="{x:Static vm:NoticeLevel.Error}">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNotices}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanOpenNotices}" Value="True">
                                    <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding WorstNoticeIcon}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorstNoticeLevel}" Value="{x:Static vm:NoticeLevel.Warning}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WorstNoticeLevel}" Value="{x:Static vm:NoticeLevel.Error}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Up: the notices open above it; down: they close -->
                        <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding CanOpenNotices, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE70E;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticesOpen}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding NoticeTitle, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run
                                Text="{Binding NoticeDetail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding PreviewHint}" />
            </StackPanel>

            <!-- Export notification, as a Windows 11 toast: the progress, then the result for a few seconds -->
            <Grid Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="380" Margin="0,0,0,4"
                  DataContext="{Binding Toast}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                  MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
                <!-- The shadow on a separate layer: an effect on the card itself would blur its text -->
                <Border CornerRadius="8" Background="{DynamicResource FlyoutBackground}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="8" BorderThickness="1" Padding="16,12,6,14"
                        Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xEC61;" FontFamily="{StaticResource IconFont}" FontSize="20" Margin="0,0,12,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top"
                                Click="ToastClose_Click" ToolTip="{local:Tr Close}" AutomationProperties.Name="{local:Tr Close}" />
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="{local:Tr ToastOpen}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" Click="ToastOpen_Click" />
                                <Button Content="{local:Tr ToastShowInFolder}" Click="ToastShowInFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
