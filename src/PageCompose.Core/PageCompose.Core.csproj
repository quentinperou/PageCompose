<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PageCompose.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- The QR codes of the numbering (MIT, offline). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- PDFsharp brings version 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7):
         a fixed version is set here. PDFsharp only uses it to sign PDFs, which the app never does. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PageCompose.Core.Tests" />
  </ItemGroup>

</Project>
